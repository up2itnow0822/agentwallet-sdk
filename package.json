{
  "name": "agentwallet-sdk",
  "version": "5.0.0-rc.1",
  "description": "Guarded non-custodial agent vault SDK with explicit owner/operator controls, verified receipts, durable budgets and wallet console.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./identity": {
      "types": "./dist/identity/index.d.ts",
      "import": "./dist/identity/index.js"
    },
    "./staking": {
      "types": "./dist/staking/index.d.ts",
      "import": "./dist/staking/index.js"
    },
    "./verify": {
      "types": "./dist/verify/index.d.ts",
      "import": "./dist/verify/index.js"
    },
    "./x402": {
      "types": "./dist/x402/index.d.ts",
      "import": "./dist/x402/index.js"
    },
    "./bridge": {
      "types": "./dist/bridge/index.d.ts",
      "import": "./dist/bridge/index.js"
    },
    "./swap": {
      "types": "./dist/swap/index.d.ts",
      "import": "./dist/swap/index.js"
    },
    "./policy": {
      "types": "./dist/policy/SpendingPolicy.d.ts",
      "import": "./dist/policy/SpendingPolicy.js"
    },
    "./plugins/elizaos": {
      "types": "./dist/plugins/elizaos.d.ts",
      "import": "./dist/plugins/elizaos.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    }
  },
  "files": [
    "dist",
    "contracts/AgentVault.sol",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "docs/migration.md",
    "src/identity/MIGRATION.md",
    "docs/security/threat-model.md",
    "docs/security/remediation.md",
    "docs/security/release-readiness.md",
    "docs/security/ci-evaluation.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && node scripts/contracts/compile.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contracts": "node scripts/contracts/test.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "test:secrets": "node scripts/secret-scan.mjs",
    "audit:all": "npm audit --audit-level=low && npm audit --omit=dev --audit-level=low && npm --prefix apps/wallet-console audit --audit-level=low && npm --prefix apps/wallet-console audit --omit=dev --audit-level=low",
    "ui:dev": "npm --prefix apps/wallet-console run dev",
    "ui:build": "npm --prefix apps/wallet-console run build",
    "verify": "npm run typecheck && npm test && npm run test:contracts && npm run build && npm run test:package && npm run test:secrets && npm run ui:build && npm --prefix apps/wallet-console run test:unit && npm --prefix apps/wallet-console test && npm run audit:all",
    "clean": "node scripts/clean.mjs"
  },
  "keywords": [
    "agent-wallet",
    "non-custodial",
    "guarded-vault",
    "ai-agent",
    "spending-limits",
    "crypto",
    "web3"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/up2itnow0822/agentwallet-sdk"
  },
  "author": "up2itnow5280",
  "dependencies": {
    "@noble/ed25519": "2.3.0",
    "@noble/hashes": "1.8.0",
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "@openzeppelin/contracts": "5.6.1",
    "solc": "0.8.37",
    "@ethereumjs/vm": "10.1.3",
    "@ethereumjs/common": "10.1.3",
    "@ethereumjs/tx": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@ethereumjs/block": "10.1.3"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
